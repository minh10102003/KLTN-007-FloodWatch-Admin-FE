# Base URL của Backend API (Railway production)
VITE_API_BASE_URL=https://api.floodsight.id.vn
# (Local dev) Proxy target cho Vite de tranh CORS tren browser.
# VITE_API_PROXY_TARGET=https://api.floodsight.id.vn

# (Khuyen nghi) Fallback khi domain chinh bi ERR_NETWORK/net::ERR_FAILED.
# Mac dinh da tro den Railway app domain neu khong khai bao.
# VITE_API_FALLBACK_BASE_URL=https://kltn-007-floodwatch-be-production.up.railway.app

# (Tùy chọn) Base URL riêng cho ảnh upload (/uploads/...). Mặc định = VITE_API_BASE_URL.
# Dùng khi BE phục vụ static qua path khác, ví dụ: https://api.floodsight.id.vn/api
# Nếu trình duyệt báo 404 cho .../uploads/xxx.jpg: cần sửa BE (express.static, volume Railway, hoặc S3) — file không tồn tại trên server.

# (Tùy chọn) Path API nhật ký audit nếu BE khác với mặc định. VD: /api/audit/logs
# VITE_AUDIT_LOGS_PATH=/api/audit-logs

# (Tùy chọn) Base path API sensors nếu BE trả 404 cho /api/sensors. VD: /api/v1/sensors
# VITE_SENSORS_PATH=/api/v1/sensors

# Socket.IO — Local: copy sang `.env.local`. Production: `.env.production` hoặc Vercel Env (bắt buộc Redeploy)
VITE_SOCKET_ENABLED=true
VITE_SOCKET_URL=https://api.floodsight.id.vn
VITE_SOCKET_NAMESPACE=/admin
# Vercel/Railway: polling ổn định hơn websocket (đã set trong .env.production)
# VITE_SOCKET_TRANSPORTS=polling
# Dev: có thể bỏ VITE_SOCKET_URL → proxy Vite (localhost:5173/socket.io → API)
# BE: ADMIN_ORIGINS phải có URL admin Vercel (vd https://xxx.vercel.app)
