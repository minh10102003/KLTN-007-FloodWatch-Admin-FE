# Base URL của Backend API (Railway production)
VITE_API_BASE_URL=https://api.floodsight.id.vn

# (Tùy chọn) Base URL riêng cho ảnh upload (/uploads/...). Mặc định = VITE_API_BASE_URL.
# Dùng khi BE phục vụ static qua path khác, ví dụ: https://api.floodsight.id.vn/api
# Nếu trình duyệt báo 404 cho .../uploads/xxx.jpg: cần sửa BE (express.static, volume Railway, hoặc S3) — file không tồn tại trên server.

# (Tùy chọn) Path API nhật ký audit nếu BE khác với mặc định. VD: /api/audit/logs
# VITE_AUDIT_LOGS_PATH=/api/audit-logs

# (Tùy chọn) Base path API sensors nếu BE trả 404 cho /api/sensors. VD: /api/v1/sensors
# VITE_SENSORS_PATH=/api/v1/sensors
